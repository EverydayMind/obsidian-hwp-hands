+#[cfg(test)]
+mod local_double_slim_tests {
+    use super::double_line_parts;
+    #[test]
+    fn declared_width_is_preserved() {
+        for mm in [0.12, 0.5, 0.7] {
+            let width = mm * 96.0 / 25.4;
+            let parts = double_line_parts(width);
+            assert!((parts[0].1 - width / 4.0).abs() < 1e-9);
+            assert!((parts[0].0 + width * 3.0 / 8.0).abs() < 1e-9);
