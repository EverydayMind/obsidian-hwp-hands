+/// 이중실선(DOUBLE_SLIM)의 (선 굵기, 경계선에서 각 선 중심까지 거리) px.
+///
+/// 선언 굵기 W의 이중실선은 W/4 선 두 개이고 중심은 경계선에서 ±3W/8이다(바깥 끝 ±W/2).
+/// 한컴 기준: 0.7mm → 0.18mm 두 선 0.53mm 간격, 0.5mm → 0.12mm/0.37mm,
+/// 0.12mm → 0.03mm/0.08mm (HWPX to HTML2 docs/DECISIONS.md). 픽셀 최소값으로
+/// 문서의 공칭 기하를 부풀리지 않는다.
+fn double_border_metrics(width_index: u8) -> (f64, f64) {
+    let mm = crate::model::style::BORDER_WIDTHS
+        .get(width_index as usize)
+        .unwrap_or(&crate::model::style::BORDER_WIDTHS[0])
+        .0;
+    let width = mm * 96.0 / 25.4;
+    (width / 4.0, width * 3.0 / 8.0)
+}
