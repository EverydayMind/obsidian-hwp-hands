@@ -1191,6 +1191,49 @@ impl HwpDocument {
     ///
     /// WASM 환경에서만 사용 가능하다. Canvas 크기는 페이지 크기 × scale로 설정된다.
     /// scale이 0 이하이면 1.0으로 처리한다 (하위호환).
+    #[cfg(target_arch = "wasm32")]
+    #[wasm_bindgen(js_name = renderPageToOffscreenCanvas)]
+    pub fn render_page_to_offscreen_canvas(
+        &self,
+        page_num: u32,
+        canvas: &web_sys::OffscreenCanvas,
+        scale: f64,
+    ) -> Result<(), JsValue> {
+        use crate::renderer::layer_renderer::LayerRenderer;
+        use crate::renderer::offscreen_canvas::OffscreenCanvasRenderer;
+
+        crate::renderer::offscreen_canvas::reset_resources();
+        let result: Result<(), JsValue> = crate::renderer::image_resolver::with_decoded_handoff(|| {
+            let tree = self
+                .build_canvas_page_layer_tree_with_profile(
+                    page_num,
+                    crate::paint::RenderProfile::Screen,
+                )
+                .map_err(JsValue::from)?;
+
+            let scale = normalize_canvas_scale(tree.page_width, tree.page_height, scale)
+                .map_err(JsValue::from_str)?;
+
+            // 캔버스 크기 = 페이지 크기 × scale
+            canvas.set_width(scaled_canvas_extent(tree.page_width, scale));
+            canvas.set_height(scaled_canvas_extent(tree.page_height, scale));
+
+            let mut renderer = OffscreenCanvasRenderer::new(canvas)?;
+            renderer.set_hft_outline_fonts(&self.hft_outline_fonts);
+            renderer.show_paragraph_marks = self.show_paragraph_marks;
+            renderer.show_control_codes = self.show_control_codes;
+            renderer.set_scale(scale);
+            renderer.render_page(&tree).map_err(JsValue::from)?;
+            Ok(())
+        });
+        let failed = crate::renderer::offscreen_canvas::resources_failed();
+        crate::renderer::offscreen_canvas::reset_resources();
+        result?;
+        if failed { return Err(JsValue::from_str("Canvas image resource could not be decoded safely")); }
+        Ok(())
+    }
+
+
