+#[test]
+fn test_insert_at_logical_start_stays_after_structural_controls() {
+    // A logical offset of zero can contain paragraph-level structural
+    // controls before an inline footnote. Text must be inserted between them.
+    let mut para = Paragraph {
+        text: "AB".to_string(),
+        char_count: 34,
+        char_offsets: vec![24, 33],
+        controls: vec![
+            Control::SectionDef(Box::default()),
+            Control::ColumnDef(ColumnDef::default()),
+            Control::Footnote(Box::default()),
+            Control::Table(Box::default()),
+        ],
+        ..Default::default()
+    };
+    assert_eq!(para.control_utf16_positions(), vec![0, 8, 16, 25]);
+
+    para.insert_text_at(0, "XYZ ");
+
+    assert_eq!(para.text, "XYZ AB");
+    assert_eq!(
+        para.control_utf16_positions(),
+        vec![0, 8, 20, 29],
+        "structural controls stay at the paragraph head and inline controls shift with the text"
+    );
+}
