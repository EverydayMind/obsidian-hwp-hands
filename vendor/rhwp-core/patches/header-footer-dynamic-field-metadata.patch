+/// 머리말/꼬리말 필드의 포맷 비종속 범위다. start/end는 실제 편집 텍스트의 문자
+/// 인덱스이고, marker는 저장 포맷 컨트롤을 식별하는 내부 토큰이다.
+#[derive(Debug, Clone, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+struct HeaderFooterDynamicField {
+    start: usize,
+    end: usize,
+    #[serde(rename = "type")]
+    field_type: &'static str,
+    marker: char,
+}
+
+/// 필드 토큰 문자열과 HWP/HWPX의 native 컨트롤을 같은 논리 필드로 조회한다.
+/// 원시 text와 범위는 편집 좌표를 위해 그대로 두고, logicalText에서만 native 필드
+/// 표시 문자열을 한 글자 토큰으로 접는다.
+fn header_footer_dynamic_fields(
+    paragraph: &crate::model::paragraph::Paragraph,
+) -> Vec<HeaderFooterDynamicField> {
+    use crate::model::control::{AutoNumberType, Control, FieldType};
+
+    let chars: Vec<char> = paragraph.text.chars().collect();
+    let mut fields = Vec::new();
+    for (index, ch) in chars.iter().copied().enumerate() {
+        let (field_type, marker) = match ch {
+            '\u{0015}' => ("pageNumber", ch),
+            '\u{0016}' => ("totalPages", ch),
+            '\u{0017}' => ("fileName", ch),
+            _ => continue,
+        };
+        fields.push(HeaderFooterDynamicField {
+            start: index,
+            end: index + 1,
+            field_type,
+            marker,
+        });
+    }
+
+    let control_positions = paragraph.control_text_positions();
+    for (control_index, control) in paragraph.controls.iter().enumerate() {
+        let start = control_positions.get(control_index).copied();
+        match control {
+            Control::AutoNumber(number) => {
+                let (field_type, marker) = match number.number_type {
+                    AutoNumberType::Page => ("pageNumber", '\u{0015}'),
+                    AutoNumberType::TotalPage => ("totalPages", '\u{0016}'),
+                    _ => continue,
+                };
+                // Parsed HWP/HWPX stores an automatic-number control after a trailing
+                // one-character placeholder. The generic edit coordinate therefore points
+                // just past the text; header/footer identity maps that control back to the
+                // placeholder without changing the renderer's or editor's raw coordinates.
+                let start = start
+                    .filter(|position| *position < chars.len())
+                    .or_else(|| {
+                        let trailing_units = paragraph
+                            .char_offsets
+                            .last()
+                            .zip(chars.last())
+                            .map_or(0, |(offset, ch)| {
+                                paragraph
+                                    .char_count
+                                    .saturating_sub(*offset + Paragraph::char_stream_len(*ch))
+                            });
+                        (start == Some(chars.len())
+                            && chars.last() == Some(&' ')
+                            && trailing_units >= 8)
+                            .then_some(chars.len() - 1)
+                    });
+                let Some(start) = start else { continue };
+                // Do not infer a field from a non-placeholder character.
+                if chars.get(start) != Some(&' ') {
+                    continue;
+                }
+                fields.push(HeaderFooterDynamicField {
+                    start,
+                    end: start + 1,
+                    field_type,
+                    marker,
+                });
+            }
+            Control::Field(field)
+                if field.field_type == FieldType::Path && field.command == "$F" =>
+            {
+                if let Some(range) = paragraph
+                    .field_ranges
+                    .iter()
+                    .find(|range| range.control_idx == control_index)
+                    .filter(|range| {
+                        range.start_char_idx < range.end_char_idx
+                            && range.end_char_idx <= chars.len()
+                    })
+                {
+                    fields.push(HeaderFooterDynamicField {
+                        start: range.start_char_idx,
+                        end: range.end_char_idx,
+                        field_type: "fileName",
+                        marker: '\u{0017}',
+                    });
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fields.sort_by_key(|field| (field.start, field.end));
+    let mut non_overlapping = Vec::with_capacity(fields.len());
+    let mut end = 0;
+    for field in fields {
+        if field.start >= end {
+            end = field.end;
+            non_overlapping.push(field);
+        }
+    }
+    non_overlapping
+}
+
+fn logical_header_footer_text(text: &str, fields: &[HeaderFooterDynamicField]) -> String {
+    let chars: Vec<char> = text.chars().collect();
+    let mut logical = String::with_capacity(text.len());
+    let mut cursor = 0;
+    for field in fields {
+        if field.start < cursor || field.end > chars.len() {
+            continue;
+        }
+        logical.extend(chars[cursor..field.start].iter());
+        logical.push(field.marker);
+        cursor = field.end;
+    }
+    logical.extend(chars[cursor..].iter());
+    logical
+}
