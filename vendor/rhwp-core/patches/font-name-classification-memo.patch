+/// KoPub 계열 판정 `(돋움, 바탕)` — 글꼴 이름마다 한 번만 한다.
+///
+/// 글자 폭을 잴 때마다(`measure_char_width_embedded_decision_for_font`) 불리는데, 매번 이름
+/// 전체를 소문자로 바꾸고 부분 문자열을 네 번 찾으면 큰 문서에서 입력 한 번의 재조판 시간
+/// 절반 가까이가 이 판정에 들었다. 판정은 이름만의 함수라 결과가 같다.
+fn kopub_face_flags(primary_name: &str) -> (bool, bool) {
+    thread_local! {
+        static FLAGS: std::cell::RefCell<std::collections::HashMap<String, (bool, bool)>> =
+            std::cell::RefCell::new(std::collections::HashMap::new());
+    }
+    FLAGS.with(|flags| {
+        if let Some(found) = flags.borrow().get(primary_name) {
+            return *found;
+        }
+        let lower = primary_name.to_lowercase();
+        let found = (
+            primary_name.contains("KoPub돋움체") || lower.contains("kopub dotum"),
+            primary_name.contains("KoPub바탕체") || lower.contains("kopub batang"),
+        );
+        flags.borrow_mut().insert(primary_name.to_owned(), found);
+        found
+    })
+}
