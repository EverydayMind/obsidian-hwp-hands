+/// 줄 기하가 그대로인 타자는 쪽 나눔을 다시 하지 않는다. 배치 안의 같은 편집은 항상
+/// 전체 쪽 나눔을 하므로, 두 경로의 쪽 수와 모든 쪽의 SVG가 같아야 한다.
+#[test]
+fn test_geometry_preserving_typing_matches_full_pagination() {
+    let mut direct = batch_body_format_doc();
+    let mut batched = batch_body_format_doc();
+    let grow = "줄을 넘겨 문단 높이를 바꾸는 긴 삽입입니다. ".repeat(8);
+    // (문단, 위치, 넣을 글, 지울 글자 수) — 같은 문단의 연속 타자, 줄이 느는 삽입, 줄이 주는 삭제.
+    let steps: Vec<(usize, usize, &str, usize)> = vec![
+        (3, 2, "가", 0),
+        (3, 3, "나", 0),
+        (3, 4, " ", 0),
+        (3, 2, "", 1),
+        (30, 5, "a", 0),
+        (30, 6, "b", 0),
+        (30, 0, grow.as_str(), 0),
+        (30, 1, "다", 0),
+        (30, 0, "", 150),
+        (30, 1, "라", 0),
+        (58, 1, "마", 0),
+        (58, 2, "바", 0),
+    ];
+    for (step, (para, offset, text, delete)) in steps.into_iter().enumerate() {
+        batched.begin_batch_native().unwrap();
+        if delete > 0 {
+            direct.delete_text_native(0, para, offset, delete).unwrap();
+            batched.delete_text_native(0, para, offset, delete).unwrap();
+        } else {
+            direct.insert_text_native(0, para, offset, text).unwrap();
+            batched.insert_text_native(0, para, offset, text).unwrap();
+        }
+        batched.end_batch_native().unwrap();
+        assert!(direct.dirty_sections.iter().all(|dirty| !*dirty), "step {step} left a dirty section");
+        assert_eq!(
+            direct.document.sections[0].paragraphs[para].line_segs,
+            batched.document.sections[0].paragraphs[para].line_segs,
+            "step {step} line segments"
+        );
+        assert_eq!(direct.page_count(), batched.page_count(), "step {step} page count");
+        for page in 0..direct.page_count() {
+            assert_eq!(
+                direct.render_page_svg_native(page).unwrap(),
+                batched.render_page_svg_native(page).unwrap(),
+                "step {step} page {page} differs between the normal and the batched edit"
+            );
+        }
+    }
+}
