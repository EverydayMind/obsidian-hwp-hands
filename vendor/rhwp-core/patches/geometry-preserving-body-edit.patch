+#[test]
+fn test_geometry_preserving_typing_matches_full_pagination() {
+    fn fixture() -> HwpDocument {
+        let mut doc = create_editable_doc();
+        doc.begin_batch_native().unwrap();
+        doc.insert_text_native(0, 0, 0, "? ??").unwrap();
+        for i in 1..60 {
+            doc.split_paragraph_native(0, i - 1, if i == 1 { 4 } else { 20 }, None).unwrap();
+            doc.insert_text_native(0, i, 0, "?? ????? ????? ?????").unwrap();
+        }
+        doc.end_batch_native().unwrap();
+        doc
+    }
+    let mut direct = fixture();
+    let mut batched = fixture();
+    let grow = "?? ?? ?? ??? ??? ? ?????. ".repeat(8);
+    let steps = [(3, 2, "?", 0), (3, 3, "?", 0), (3, 4, " ", 0),
+        (3, 2, "", 1), (30, 5, "a", 0), (30, 6, "??", 0),
+        (30, 0, grow.as_str(), 0), (30, 1, "?", 0), (30, 0, "", 150),
+        (30, 1, "?", 0), (58, 1, "?", 0), (58, 2, "?", 0)];
+    for (step, (para, offset, text, delete)) in steps.into_iter().enumerate() {
+        // Populate both v0.9.0 layer tree caches before changing the text.
+        for page in 0..direct.page_count() {
+            direct.get_page_layer_tree_native(page).unwrap();
+            direct.render_page_svg_native(page).unwrap();
+        }
+        batched.begin_batch_native().unwrap();
+        if delete > 0 {
+            direct.delete_text_native(0, para, offset, delete).unwrap();
+            batched.delete_text_native(0, para, offset, delete).unwrap();
+        } else {
+            direct.insert_text_native(0, para, offset, text).unwrap();
+            batched.insert_text_native(0, para, offset, text).unwrap();
+        }
+        batched.end_batch_native().unwrap();
+        assert!(direct.dirty_sections.iter().all(|dirty| !*dirty));
+        if step == 1 {
+            assert!(direct.dirty_paragraphs[0].as_ref().unwrap()[para], "expected fast path");
+        }
+        assert_eq!(direct.document.sections[0].paragraphs[para].line_segs,
+                   batched.document.sections[0].paragraphs[para].line_segs, "step {step}");
+        assert_eq!(direct.page_count(), batched.page_count(), "step {step}");
+        for page in 0..direct.page_count() {
+            assert_eq!(direct.render_page_svg_native(page).unwrap(), batched.render_page_svg_native(page).unwrap(), "step {step} page {page}");
+            assert_eq!(direct.get_page_layer_tree_native(page).unwrap(), batched.get_page_layer_tree_native(page).unwrap(), "layer step {step} page {page}");
+        }
+    }
+    // A later edit that does require pagination must consume all pending
+    // incremental paragraph measurements from earlier fast edits.
+    direct.mark_section_dirty(0);
+    direct.repaginate_if_needed();
+    for page in 0..direct.page_count() {
+        assert_eq!(direct.render_page_svg_native(page).unwrap(), batched.render_page_svg_native(page).unwrap());
+    }
+}
