+    // Reuse pagination only after a previous reflow established the same line
+    // geometry. Stored import ladders, objects, normalization, batches and dirty
+    // sections retain the full path. Character offsets are recomposed, never cached.
+    fn stable_body_geometry(&self, si: usize, pi: usize) -> Option<Vec<LineSeg>> {
+        let para = &self.document.sections[si].paragraphs[pi];
+        if self.batch_mode
+            || self.dirty_sections.iter().any(|dirty| *dirty)
+            || self.pending_pagination_job.is_some()
+            || self.deferred_pagination_descriptor.is_some()
+            || self
+                .render_normalization
+                .sections
+                .get(si)
+                .is_some_and(|s| s.is_some())
+            || !para.controls.is_empty()
+            || !para.field_ranges.is_empty()
+            || para.text.trim().is_empty()
+            || para.text.chars().any(|c| c.is_control())
+            || self.composed[si][pi].numbering_text.is_some()
+            || para.line_segs.is_empty()
+            || para.layout_space_metrics.len() != para.line_segs.len()
+            || para.stored_text_partition_is_dirty()
+        {
+            return None;
+        }
+        Some(para.line_segs.clone())
+    }
+
+    fn reuse_body_geometry(&mut self, si: usize, pi: usize, before: Option<&[LineSeg]>) -> bool {
+        let Some(before) = before else {
+            return false;
+        };
+        let para = &self.document.sections[si].paragraphs[pi];
+        if para.text.trim().is_empty()
+            || para.text.chars().any(|c| c.is_control())
+            || before.len() != para.line_segs.len()
+            || !before.iter().zip(&para.line_segs).all(|(a, b)| {
+                let mut old = a.clone();
+                // Pagination owns line indices, composition owns UTF-16 text cuts.
+                old.text_start = b.text_start;
+                old == *b
+            })
+        {
+            return false;
+        }
+        self.composed[si][pi] =
+            crate::renderer::composer::compose_paragraph_with_horizontal_shaping(
+                para,
+                &self.styles,
+            );
+        self.invalidate_page_tree_cache();
+        true
+    }
