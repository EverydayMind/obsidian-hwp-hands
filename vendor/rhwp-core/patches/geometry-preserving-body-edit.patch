+    // Reuse pagination only for a previously reflowed, plain paragraph whose
+    // complete line geometry survives the edit. Keep incremental measurement
+    // dirty so a later unrelated pagination cannot reuse stale text metrics.
+    fn stable_body_geometry(&self, si: usize, pi: usize) -> Option<Vec<LineSeg>> {
+        let para = &self.document.sections[si].paragraphs[pi];
+        if self.batch_mode
+            || self.dirty_sections.iter().any(|dirty| *dirty)
+            || self.pending_pagination_job.is_some()
+            || self.deferred_pagination_descriptor.is_some()
+            || self.body_page_field_error.is_some()
+            // Clearing a sealed HWP5 raw stream can change the document-wide
+            // session-edited layout profile on the first edit in this section.
+            || (self.document.sections[si].raw_provenance.is_some()
+                && self.document.sections[si].raw_stream.is_some())
+            // A pagination pass refreshes exact font contexts; do not bypass it
+            // while any exact font sources may have changed independently.
+            || self.layout_engine.exact_font_source_registry_counts().0 != 0
+            || self.styles.kerning_measurement_context.is_some()
+            || self.styles.horizontal_shaping_context.is_some()
+            || self.render_normalization.sections.get(si).is_some_and(|s| s.is_some())
+            || !para.controls.is_empty()
+            || !para.field_ranges.is_empty()
+            || !para.layout_field_values.is_empty()
+            || para.layout_object_projection || para.layout_float_band
+            || para.text.trim().is_empty()
+            || para.text.chars().any(|c| c.is_control())
+            || self.composed[si][pi].numbering_text.is_some()
+            || para.line_segs.is_empty()
+            || para.layout_space_metrics.len() != para.line_segs.len()
+            || para.stored_text_partition_is_dirty()
+        {
+            return None;
+        }
+        Some(para.line_segs.clone())
+    }
+
+    fn reuse_body_geometry(&mut self, si: usize, pi: usize, before: Option<&[LineSeg]>) -> bool {
+        let Some(before) = before else { return false; };
+        let para = &self.document.sections[si].paragraphs[pi];
+        if para.text.trim().is_empty()
+            || para.text.chars().any(|c| c.is_control())
+            || before.len() != para.line_segs.len()
+            || !before.iter().zip(&para.line_segs).all(|(a, b)| {
+                let mut old = a.clone();
+                old.text_start = b.text_start;
+                old == *b
+            })
+        {
+            return false;
+        }
+        // Match recompose_paragraph's section tab scope and all cache invalidation,
+        // but do not mark pagination dirty when its geometry is unchanged.
+        self.invalidate_page_tree_cache();
+        let _tabs = self.styles.section_tab_scope(
+            self.document.sections[si].section_def.default_tab_spacing, self.dpi,
+        );
+        self.composed[si][pi] = crate::renderer::composer::compose_paragraph_with_horizontal_shaping(
+            para, &self.styles,
+        );
+        self.invalidate_render_normalization_section(si);
+        self.mark_paragraph_dirty(si, pi);
+        true
+    }
