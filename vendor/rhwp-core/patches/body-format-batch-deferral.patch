+/// 배치 범위 서식 문서: 쪽이 여럿이고, 범위 뒤 문단에 이미 번호가 붙어 있다.
+fn batch_body_format_doc() -> HwpDocument {
+    let mut doc = create_editable_doc();
+    for index in 0..60 {
+        let text = format!("문단 {index} 배치 서식 결과가 배치 밖 결과와 같은지 확인하는 긴 본문입니다. ").repeat(3);
+        doc.insert_text_native(0, index, 0, &text).unwrap();
+        doc.split_paragraph_native(0, index, text.chars().count(), None).unwrap();
+    }
+    let numbering = doc.ensure_default_numbering();
+    let numbered = format!(r#"{{"headType":"Number","numberingId":{numbering},"paraLevel":0}}"#);
+    for para in 40..45 {
+        doc.apply_para_format_native(0, para, &numbered).unwrap();
+    }
+    doc
+}
+
+fn apply_body_range_formatting(doc: &mut HwpDocument, numbering: u16) {
+    let numbered = format!(r#"{{"headType":"Number","numberingId":{numbering},"paraLevel":0}}"#);
+    for para in 5..40 {
+        let length = doc.document.sections[0].paragraphs[para].text.chars().count();
+        doc.apply_char_format_native(0, para, 0, length, r#"{"bold":true,"fontSize":1600}"#).unwrap();
+        doc.apply_para_format_native(0, para, &numbered).unwrap();
+    }
+    for para in 45..50 {
+        doc.apply_style_native(0, para, 1).unwrap();
+    }
+}
+
+#[test]
+fn test_batch_body_range_format_matches_unbatched_render() {
+    let mut direct = batch_body_format_doc();
+    let mut batched = batch_body_format_doc();
+    let numbering = direct.ensure_default_numbering();
+    assert_eq!(numbering, batched.ensure_default_numbering());
+    let pages_before = direct.page_count();
+
+    apply_body_range_formatting(&mut direct, numbering);
+    batched.begin_batch_native().unwrap();
+    apply_body_range_formatting(&mut batched, numbering);
+    assert_eq!(batched.batch_recompose_sections, vec![0]);
+    let events = batched.end_batch_native().unwrap();
+    assert!(events.contains("\"type\":\"CharFormatChanged\""));
+    assert!(events.contains("\"type\":\"ParaFormatChanged\""));
+    assert!(batched.batch_recompose_sections.is_empty());
+
+    assert!(direct.page_count() > pages_before, "16pt bold text should reflow onto more pages");
+    assert_eq!(batched.page_count(), direct.page_count());
+    for page in 0..direct.page_count() {
+        assert_eq!(
+            batched.render_page_svg_native(page).unwrap(),
+            direct.render_page_svg_native(page).unwrap(),
+            "page {page} differs between batched and unbatched range formatting"
+        );
+    }
+}
