+#[test]
+fn test_batch_body_range_format_matches_unbatched_render() {
+    fn fixture() -> (HwpDocument, u16, usize, usize) {
+        let mut doc = create_editable_doc();
+        for index in 0..55 {
+            let text = format!("Paragraph {index}: Long body text to wrap across lines and pages. ").repeat(3);
+            doc.insert_text_native(0, index, 0, &text).unwrap();
+            doc.split_paragraph_native(0, index, text.chars().count(), None).unwrap();
+        }
+        let numbering = doc.ensure_default_numbering();
+        let numbered = format!(r#"{{"headType":"Number","numberingId":{numbering},"paraLevel":0}}"#);
+        for para in 40..45 { doc.apply_para_format_native(0, para, &numbered).unwrap(); }
+        let style = doc.create_style(r#"{"name":"Wide","type":0}"#) as usize;
+        assert!(doc.update_style_shapes(style as u32, r#"{"fontSize":1500}"#, r#"{"marginLeft":4000}"#));
+        let char_style = doc.create_style(r#"{"name":"Large","type":1}"#) as usize;
+        assert!(doc.update_style_shapes(char_style as u32, r#"{"fontSize":1700}"#, "{}"));
+        (doc, numbering, style, char_style)
+    }
+    fn apply(doc: &mut HwpDocument, numbering: u16, style: usize, char_style: usize) {
+        let numbered = format!(r#"{{"headType":"Number","numberingId":{numbering},"paraLevel":0,"marginLeft":3000,"lineSpacing":200,"lineSpacingType":"Percent"}}"#);
+        for para in 5..35 {
+            let len = doc.core.document.sections[0].paragraphs[para].text.chars().count();
+            doc.apply_char_format_native(0, para, 0, len, r#"{"bold":true,"fontSize":1600}"#).unwrap();
+            doc.apply_para_format_native(0, para, &numbered).unwrap();
+        }
+        for para in 35..40 { doc.apply_style_native(0, para, style).unwrap(); }
+        for para in 45..50 { doc.apply_style_native(0, para, char_style).unwrap(); }
+    }
+    let (mut direct, numbering, style, char_style) = fixture();
+    let (mut batched, n2, s2, c2) = fixture();
+    assert_eq!((numbering, style, char_style), (n2, s2, c2));
+    let before = direct.page_count();
+    for page in 0..batched.page_count() {
+        batched.get_page_layer_tree_native(page).unwrap();
+        batched.render_page_svg_native(page).unwrap();
+    }
+    apply(&mut direct, numbering, style, char_style);
+    batched.begin_batch_native().unwrap();
+    apply(&mut batched, numbering, style, char_style);
+    assert_eq!(batched.core.batch_recompose_sections, vec![0]);
+    let events = batched.end_batch_native().unwrap();
+    assert!(events.contains("CharFormatChanged") && events.contains("ParaFormatChanged"));
+    assert!(batched.core.batch_recompose_sections.is_empty());
+    assert!(direct.page_count() > before, "formatting must reflow the fixture");
+    assert_eq!(direct.page_count(), batched.page_count());
+    for page in 0..direct.page_count() {
+        assert_eq!(direct.render_page_svg_native(page).unwrap(), batched.render_page_svg_native(page).unwrap(), "page {page}");
+        assert_eq!(direct.get_page_layer_tree_native(page).unwrap(), batched.get_page_layer_tree_native(page).unwrap(), "layer page {page}");
+    }
+}
